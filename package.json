{
  "name": "opencrawl-demo",
  "version": "1.0.0",
  "description": "OpenCrawl demo — RAG chat over a pre-indexed corpus, with its embedding space and knowledge graph",
  "main": "backend/server.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch-path=backend backend/server.js",
    "dev:web": "npm --prefix frontend run dev",
    "dev:all": "node scripts/dev.mjs",
    "build:web": "npm --prefix frontend run build",
    "install:web": "npm --prefix frontend install",
    "test:api": "node tests/test_api.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "fetch:model": "node scripts/fetch_model.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.1.0",
    "umap-js": "^1.4.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "playwright": "^1.61.1",
    "prisma": "^6.19.3"
  }
}
